# Admin panel / license server config (server-side only - never commit real values).
# Copy to .env.local and fill in.

# Single password for the /admin login page.
PLC_ADMIN_PASSWORD=

# Secret used to sign admin session tokens (long random string). Defaults to PLC_ADMIN_KEY if unset.
PLC_ADMIN_SESSION_SECRET=

# Base URL of the deployed license server (your Render URL), e.g. https://perez-live-cam-license.onrender.com
PLC_LICENSE_API_URL=

# Admin API key - MUST match the PLC_ADMIN_KEY set on the license server.
PLC_ADMIN_KEY=
